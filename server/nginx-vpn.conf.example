server {
    listen 80;
    listen [::]:80;
    server_name vlr.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Прикрытие для VLESS+Reality: только localhost, наружу не слушает.
# Незнакомый TLS-клиент (активный зонд) получает настоящий сайт.
server {
    listen 127.0.0.1:9446 ssl http2;
    server_name vlr.example.com;

    ssl_certificate /etc/letsencrypt/live/vlr.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vlr.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:vpn905911:1m;
    ssl_session_timeout 1h;

    # Сайт-прикрытие: подставьте СВОЙ домен/сайт. Нельзя проксировать на
    # чужой домен (microsoft.com и т.п.) — это и есть «чужой» признак для зонда.
    location / {
        proxy_pass https://example.com;
        proxy_ssl_server_name on;
        proxy_set_header Host example.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
